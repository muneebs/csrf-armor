{
  "name": "@csrf-armor/testing",
  "version": "2.0.0",
  "description": "Testing utilities for CSRF Armor - Builders and assertions for CSRF tests",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "pretest": "cd ../core \u0026\u0026 pnpm run build",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "csrf",
    "security",
    "testing",
    "vitest",
    "csrf-protection"
  ],
  "author": "Muneeb Samuels",
  "license": "MIT",
  "dependencies": {
    "@csrf-armor/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.20.1",
    "typescript": "^5",
    "vitest": "^2.0.0"
  }
}
